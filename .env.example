# SolveX4Schools — server configuration
#
# NOT ONE of these carries a NEXT_PUBLIC_ prefix, and that is the mechanism
# rather than a convention: a NEXT_PUBLIC_ variable is inlined into the client
# bundle at build time, so prefixing one to "make something work" ships it to
# every browser permanently — including the ones belonging to fourteen-year-olds
# who will open DevTools.
#
# ─────────────────────────────────────────────────────────────────────────────
# THE PILOT PRODUCTION SET — what a real deployment must actually have
# ─────────────────────────────────────────────────────────────────────────────
#
# The rest of this file is reference material for every knob that exists. This
# block is the short answer, and it is the configuration the release candidate
# was accepted against. Six values; the app refuses to boot without the ones
# marked REQUIRED.
#
#   DATABASE_URL=postgres://…            REQUIRED. Managed Postgres, SSL on.
#   LEARNING_ATTESTATION_SECRET=…        REQUIRED. openssl rand -hex 32
#   NOVA_PROVIDER=deepseek
#   DEEPSEEK_API_KEY=…                   REQUIRED when NOVA_PROVIDER=deepseek
#   EXEC_PROVIDER=judge0_rapidapi
#   JUDGE0_RAPIDAPI_KEY=…                REQUIRED when EXEC_PROVIDER=judge0_rapidapi
#
# Optional but recommended: LEARNING_ADMIN_TOKEN (uptime monitoring),
# JUDGE0_MAX_CONCURRENT_REQUESTS=2 (already the default).
#
# For the pilot, SET TOGETHER OR NOT AT ALL: LEAGUES_ENABLED=true and
# LEAGUES_SCHOOLS=innovation-tech. See the league block at the bottom —
# student-visible peer ranking is a decision somebody makes, not a default a
# deploy turns on, and `LEAGUES_ENABLED` without an allowlist turns it on for
# EVERY school in the deployment.
#
# NODE_ENV must be `production`. It is what arms the boot assertion, the secure
# cookie flags, and the 404s on /dev and /brilliant. A production deployment
# running as `development` is the single most consequential mistake available
# here, because everything appears to work.

# ── Storage ─────────────────────────────────────────────────────────────────
# Development: PGlite writes here. Production: set DATABASE_URL instead and this
# is ignored.
LEARNING_DATA_DIR=.data/learning
# DATABASE_URL=postgres://user:pass@host:5432/solvex

# ── Attestation ─────────────────────────────────────────────────────────────
# Signer and verifier must hold the SAME value. Generate with:
#   openssl rand -hex 32
# Absent in production, the app refuses to start — because absent at runtime it
# fails silently: every verdict downgrades to browser trust and the product goes
# on looking like it works while it has stopped learning anything.
# LEARNING_ATTESTATION_SECRET=

# ── Reducer ─────────────────────────────────────────────────────────────────
# The in-process interval is what makes "nobody clicks anything" true. Set to
# false only on a deployment that cannot keep a process warm, and then wire an
# external cron to POST /api/learning/reduce.
LEARNING_SWEEP_IN_PROCESS=true
LEARNING_SWEEP_INTERVAL_MS=20000
# LEARNING_CRON_SECRET=

# ── Nova ────────────────────────────────────────────────────────────────────
# `echo` needs no credentials and runs offline. The pedagogy — the ladder, the
# caps, the safety gate, the output validator, the refusal to name a
# misconception without evidence — is ALL upstream of the model, so every one of
# those rules is exercisable end to end against `echo`. What is missing without
# a key is the wording, and the panel says so in its own banner rather than
# leaving a learner to work it out from the prose.
NOVA_PROVIDER=echo
# NOVA_PROVIDER=deepseek

# The key. This is the ONE value you have to add for Nova to speak.
# Server-side only, read in schools/config.ts and nowhere else. See
# docs/nova/DEEPSEEK_SETUP.md.
# DEEPSEEK_API_KEY=<ADD_ME>

# DEEPSEEK_BASE_URL=https://api.deepseek.com

# The model.
#
# DO NOT set this back to `deepseek-chat`. DeepSeek RETIRED that id on
# 2026-07-24 and it now returns an error rather than resolving — so a .env
# restored from an old backup produces a Nova where every single request fails
# upstream, with a valid key. `deepseek-v4-flash` is what `deepseek-chat` was
# aliased to during the migration window.
# DEEPSEEK_MODEL=deepseek-v4-flash

# Thinking mode. Off unless you set this to `true`.
#
# V4 enables it by default at `high` effort and reasoning tokens bill as OUTPUT.
# For a reply capped at six sentences whose shape the hint ladder already
# decided, that is most of the cost and most of the latency spent on a chain of
# thought nobody reads.
# DEEPSEEK_THINKING=false

# The kill switch. Independent of the credential, so a school that wants the
# tutor off for a week of assessments does not have to delete a secret.
# NOVA_ENABLED=true

# NOVA_REQUEST_TIMEOUT_MS=30000
# NOVA_MAX_OUTPUT_TOKENS=500

# ── Nova ceilings ───────────────────────────────────────────────────────────
# Two units, because two different things go wrong.
#
# PER LEARNER, PER DAY. The burst bucket (20 requests, refilling 10/min) stops a
# flood; it does nothing about a bored learner asking for a hint every forty
# seconds for six hours, which is not an attack and costs real money.
# NOVA_DAILY_REQUEST_LIMIT=60
#
# PER DEPLOYMENT, PER MONTH. The per-learner limit times eighteen learners is
# still a number nobody chose. These are the numbers somebody chose, checked
# before the provider is called. Set any to 0 to disable that ceiling.
# NOVA_MONTHLY_INPUT_TOKEN_LIMIT=20000000
# NOVA_MONTHLY_OUTPUT_TOKEN_LIMIT=4000000
# NOVA_MONTHLY_COST_LIMIT_USD=25
#
# Prices, so the USD cap can be computed from tokens. Defaults are DeepSeek's
# PEAK rate for v4-flash on a cache miss — deliberately, because peak is
# 01:00–04:00 and 06:00–10:00 UTC, which in Almaty is 06:00–09:00 and
# 11:00–15:00: the school day. Budgeting at the off-peak rate would put the cap
# at roughly twice the money it claims to be.
# DEEPSEEK_INPUT_USD_PER_MTOK=0.44
# DEEPSEEK_OUTPUT_USD_PER_MTOK=1.32

# ── Code execution ──────────────────────────────────────────────────────────
# Only SUBMIT is configured here. RUN — the learner's own input — is Pyodide in
# their browser and needs nothing set.
#
# `local` is a subprocess and NOT a sandbox: it runs a student's Python as a
# child of the app process, with the app's filesystem, network and credentials.
# It refuses to run in production, and that refusal used to be swallowed — the
# submit route caught it and left the verdict `unknown`, so a real school
# deployment booted clean and then quietly failed to grade every code task
# while telling learners the sandbox was unavailable.
#
# It no longer boots. In production the app REFUSES TO START unless a real judge
# is configured WITH the piece of it whose absence is silent: `piston` with
# PISTON_URL, or `judge0_rapidapi` with JUDGE0_RAPIDAPI_KEY. Any other value —
# `local`, unset, or a typo — is a boot failure, because a typo produces exactly
# the same silence as omitting it.
# DEVELOPMENT DEFAULT. Not a production value — see the two options below.
EXEC_PROVIDER=local
EXEC_PYTHON_BIN=python3
#
# ── Which judge production uses ──────────────────────────────────────────────
#
# This file used to say "Production: self-hosted Piston on a Kazakh host" here
# as though the question were settled. It is not the judge this release was
# accepted against, and leaving the sentence in meant an operator setting up the
# pilot would configure the wrong one — landing on `EXEC_PROVIDER=piston` with
# no PISTON_URL, which is a boot failure, or with a URL pointing at nothing,
# which grades nothing.
#
# THE PILOT USES JUDGE0 (see the block below). Both providers are supported and
# either is a legitimate choice; what follows is the difference that decides it.
#
#   piston           — self-hosted, so learner source code stays on a host you
#                      control. That was the original data-residency commitment
#                      in docs/CODE_EXECUTION_DECISION.md. It needs a machine
#                      somebody runs and keeps running.
#   judge0_rapidapi  — rented, no machine to operate, and it SENDS LEARNER
#                      SOURCE CODE OUT OF KAZAKHSTAN. That is a programme
#                      decision against the commitment above, not a deployment
#                      detail, and it is the one the pilot took knowingly.
#
# Self-hosted Piston, if you take the other branch. Both lines, never one.
# EXEC_PROVIDER=piston
# PISTON_URL=http://127.0.0.1:2000

# ── Judge0 CE via RapidAPI ──────────────────────────────────────────────────
# The other trusted judge: rented rather than run. SUBMIT posts to Judge0,
# polls for the result, and hands it to SolveX's own checker. RUN is untouched
# — it stays Pyodide in the learner's browser, so twenty presses of Run cost
# zero requests here. That is the cost model, not an optimisation.
#
# THE KEY IS SERVER-ONLY. No NEXT_PUBLIC_ prefix, it travels in a header, and
# the browser never contacts judge0-ce.p.rapidapi.com at all. Anyone who finds
# themselves needing to add it to a client component has taken a wrong turn.
#
# Set EXEC_PROVIDER and the key together. In production the app REFUSES TO
# START with the first and not the second, for the same reason as PISTON_URL: a
# judge with no credential fails on every submission and settles every attempt
# as unmeasured, which boots clean and grades nothing.
#
# BEFORE YOU TURN THIS ON, read docs/CODE_EXECUTION_DECISION.md. It chose a
# Kazakh Piston partly because learner source code then does not leave the
# country; this sends it to a marketplace and on to Judge0's hosts. That is a
# programme decision, not a deployment one — and it is the decision the pilot
# made, so these two lines ARE the pilot's production configuration. Uncomment
# both.
#
# Measured live on 2026-08-30 against the real service: Python 3.14.0,
# language id 113 (discovered, not pinned), 11/11 conformance, 25/25 September
# parity, enable_network false, and every limit we send inside the plan's
# maximums. docs/infrastructure/JUDGE0_LIVE_VALIDATION.md has the numbers.
# EXEC_PROVIDER=judge0_rapidapi
# JUDGE0_RAPIDAPI_KEY=
#
# Defaults are right for the standard RapidAPI listing; set them only for a
# different host or a proxy that speaks the same API.
# JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com
# JUDGE0_RAPIDAPI_BASE_URL=https://judge0-ce.p.rapidapi.com
#
# The Python language id is DISCOVERED, not hardcoded: the provider asks
# GET /languages which Python 3 the judge has and caches the answer for the
# life of the process. Judge0's ids differ between deployments and move when
# the catalogue is rebuilt, and a stale id copied from a blog post is how a
# submission ends up running under Python 2.7. Set this only to pin a runtime
# deliberately — and know what it costs: an id with no name behind it means
# nothing in the system can say which interpreter produced a learner's
# evidence.
# JUDGE0_LANGUAGE_ID=
#
# How many submissions may be in flight at once, process-wide. Eighteen
# students times however many hidden cases arrives as one burst, and the free
# tier's real limits are unknown. Low is the safe direction: waiting is a
# slower Check, exceeding is a class told nothing could be measured.
# JUDGE0_MAX_CONCURRENT_REQUESTS=2
#
# Timing. Every poll is a billable request, so the interval backs off rather
# than hammering. The overhead budget is how much longer than the learner's own
# 5 s limit we wait for an answer, and it must stay generous — give up before
# the judge does and a genuinely slow program is recorded as the judge not
# answering, which loses the evidence rather than reporting it.
# JUDGE0_POLL_INTERVAL_MS=250
# JUDGE0_QUEUE_WAIT_MS=30000
# JUDGE0_OVERHEAD_BUDGET_MS=15000
#
# POST /submissions/batch — one request for every case instead of one each.
# OFF by default and UNVERIFIED: whether the subscribed plan exposes the batch
# endpoints, and what its maximum batch size is, cannot be known without a key.
# With it off the cases of one submission still run in parallel, bounded by
# JUDGE0_MAX_CONCURRENT_REQUESTS.
# JUDGE0_BATCH=false

# ── Health and observability ────────────────────────────────────────────────
# `GET /api/health` answers everybody. Without a credential it returns the
# TEACHER view: five capabilities in Kazakh and Russian, each naming a
# consequence ("code checking is temporarily unavailable; nobody is being marked
# wrong") and nothing about the infrastructure.
#
# The ADMIN view — providers, endpoints, the curriculum hash, reducer lag, the
# in-process counters — needs either an `admin` session or this token, sent as
# `Authorization: Bearer <token>`. Generate with:
#   openssl rand -hex 32
#
# It exists for the caller that has no session and should not have a password: an
# uptime monitor, a deploy smoke check, a curl in a runbook. Leave it unset and
# that door is simply closed — the admin view is then reachable only by a
# signed-in admin, which is the safe direction to fail.
#
# Add `?probe=1` (admin only) to put a real two-line program through the judge.
# Off by default on purpose: a monitor polling every thirty seconds would turn
# the health check into a load source against a judge sized for eighteen
# students.
# LEARNING_ADMIN_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# SolveX Leagues — the weekly student competition
# ─────────────────────────────────────────────────────────────────────────────
#
# OFF unless explicitly turned on. Note the spelling: this is `=== "true"`,
# unlike NOVA_ENABLED and LEARNING_SWEEP_IN_PROCESS which are `!== "false"` and
# therefore default ON. A competition that shows children to each other must be
# a decision somebody made, not something a deploy switches on for every school
# that happens to upgrade.
#
# What it turns on: /league, GET /api/league/me, the league tab in the student
# nav, XP awards on the submit and complete paths, and an hourly settlement
# interval. With it unset, none of that code runs and no league row is ever
# written.
#
# The nav tab is worth naming separately, because it is the half that was
# missing: with the flag on and the tab absent, /league exists, works, and is
# reachable only by typing the URL. Every learner surface now resolves
# `leagueNavVisible(user)` on the server and passes the answer to `SCHOOL_NAV`.
LEAGUES_ENABLED=true

# Which schools. Comma-separated `school_id` values; EMPTY MEANS ALL, once
# LEAGUES_ENABLED is true.
#
# NAME THE SCHOOL. An empty allowlist beside `LEAGUES_ENABLED=true` is not
# "leagues for the pilot", it is "leagues for every school this deployment ever
# serves, starting at the next deploy" — including one that has not been asked.
# The pilot's value is its `school_id`, the same string `SCHOOL_ID` carries:
#
#   LEAGUES_SCHOOLS=innovation-tech
#
# There is no `schools` table to hang a per-school column on — `school_id` is
# unregistered text across five tables — so the allowlist lives here rather than
# in the database, and `leaguesEnabledForSchool` is the one function that reads
# it. Nothing hardcodes a school name in business logic.
LEAGUES_SCHOOLS=innovation-tech

# ── What leagues do NOT need ────────────────────────────────────────────────
#
# No cron. Settlement runs from three triggers that all take the same lease: an
# hourly in-process interval, an opportunistic settle when a learner opens the
# league page, and any future scheduled call. The page read is the one that
# matters — this deployment has no cron at all (LEARNING_CRON_SECRET below is
# read into config and has no consumer), so a settlement that only ran from a
# scheduler would be a settlement that never ran.
#
# No new secret. Nothing in the league subsystem holds a credential, and no
# league value is ever NEXT_PUBLIC_.
