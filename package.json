{
  "name": "ai-website-clone-template",
  "version": "0.4.0",
  "private": true,
  "description": "Clone any website into a clean, modern Next.js codebase using AI coding agents",
  "author": "JCodesMore",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JCodesMore/ai-website-cloner-template.git"
  },
  "homepage": "https://github.com/JCodesMore/ai-website-cloner-template",
  "bugs": {
    "url": "https://github.com/JCodesMore/ai-website-cloner-template/issues"
  },
  "keywords": [
    "claude-code",
    "website-clone",
    "reverse-engineering",
    "nextjs",
    "ai",
    "template",
    "tailwindcss",
    "shadcn-ui"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node scripts/check-branch.mjs && node scripts/sync-pyodide-assets.mjs && node scripts/build-python-worker.mjs && node scripts/sync-cpp17-assets.mjs && node scripts/build-cpp-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/strip-python-assets.mjs && node scripts/sync-cpp17-assets.mjs && node scripts/build-cpp-worker.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run curriculum:validate && npm run curriculum:test-content && npm run test && npm run test:browser-cpp && npm run build && npm run check:bundle && npm run check:answers",
    "test": "vitest run",
    "test:browser-cpp": "CPP_BROWSER_GATE=1 vitest run",
    "test:li": "vitest run tests/",
    "test:golden": "vitest run tests/golden.test.ts",
    "curriculum:kk-review": "tsx --conditions=react-server scripts/kk-review.ts",
    "curriculum:validate": "tsx --conditions=react-server schools/curriculum/cli.ts",
    "test:pipeline": "vitest run tests/pipeline tests/school tests/nova tests/exec tests/store",
    "check:bundle": "node scripts/check-client-bundle.mjs",
    "check:answers": "tsx --conditions=react-server scripts/check-bundle-answers.ts",
    "curriculum:test-content": "vitest run tests/school/content-execution.test.ts tests/school/payload-privacy.test.ts tests/school/reveal-policy.test.ts tests/school/tracks.test.ts",
    "curriculum:publish": "tsx --conditions=react-server scripts/publish-curriculum.ts",
    "curriculum:unpublish": "tsx --conditions=react-server scripts/unpublish-curriculum.ts",
    "db:verify-migrations": "tsx --conditions=react-server scripts/verify-migrations.ts",
    "judge0:validate": "tsx --conditions=react-server scripts/live/judge0-validate.ts",
    "school:provision": "tsx --conditions=react-server scripts/provision-class.ts",
    "school:erase": "tsx --conditions=react-server scripts/erase-learner.ts",
    "pyodide:sync": "node scripts/sync-pyodide-assets.mjs --force",
    "pyodide:worker": "node scripts/build-python-worker.mjs",
    "test:python": "python3 -m pytest tests/python -q",
    "test:nova": "vitest run tests/nova tests/learning",
    "cpp17:sync": "node scripts/sync-cpp17-assets.mjs",
    "cpp17:worker": "node scripts/build-cpp-worker.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@electric-sql/pglite": "^0.5.7",
    "@lezer/highlight": "^1.2.3",
    "@rive-app/react-canvas": "^4.32.1",
    "@types/pg": "^8.23.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.6.0",
    "motion": "^13.1.1",
    "next": "16.3.0",
    "pg": "^8.23.0",
    "pyodide": "^314.0.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "playwright": "^1.62.1",
    "server-only": "^0.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
