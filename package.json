{
  "name": "ai-website-clone-template",
  "version": "0.4.0",
  "private": true,
  "description": "Clone any website into a clean, modern Next.js codebase using AI coding agents",
  "author": "JCodesMore",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JCodesMore/ai-website-cloner-template.git"
  },
  "homepage": "https://github.com/JCodesMore/ai-website-cloner-template",
  "bugs": {
    "url": "https://github.com/JCodesMore/ai-website-cloner-template/issues"
  },
  "keywords": [
    "claude-code",
    "website-clone",
    "reverse-engineering",
    "nextjs",
    "ai",
    "template",
    "tailwindcss",
    "shadcn-ui"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node scripts/sync-pyodide-assets.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-pyodide-assets.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run curriculum:validate && npm run curriculum:test-content && npm run test && npm run build && npm run check:bundle",
    "test": "vitest run",
    "test:li": "vitest run tests/",
    "test:golden": "vitest run tests/golden.test.ts",
    "curriculum:validate": "tsx schools/curriculum/cli.ts",
    "test:pipeline": "vitest run tests/pipeline tests/school tests/nova tests/exec tests/store",
    "check:bundle": "node scripts/check-client-bundle.mjs",
    "curriculum:test-content": "vitest run tests/school/content-execution.test.ts tests/school/payload-privacy.test.ts tests/school/reveal-policy.test.ts tests/school/tracks.test.ts",
    "curriculum:publish": "tsx scripts/publish-curriculum.ts",
    "school:provision": "tsx scripts/provision-class.ts",
    "pyodide:sync": "node scripts/sync-pyodide-assets.mjs --force"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@electric-sql/pglite": "^0.5.7",
    "@rive-app/react-canvas": "^4.32.1",
    "@types/pg": "^8.23.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.6.0",
    "motion": "^13.1.1",
    "next": "16.3.0",
    "pg": "^8.23.0",
    "pyodide": "^314.0.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "playwright": "^1.62.1",
    "server-only": "^0.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
